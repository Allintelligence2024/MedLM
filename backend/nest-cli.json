{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../mobile/assets/content/*.json",
        "outDir": "dist",
        "watchAssets": true
      }
    ],
    "tsConfigPath": "tsconfig.build.json"
  }
}

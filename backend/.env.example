# MedAnki DZ — variables d'environnement backend
#
# Copier en `.env` pour le développement local, ou injecter via la plateforme
# de déploiement (Heroku, Fly, K8s…). JAMAIS en clair dans le repo.

# ── Base de données ─────────────────────────────────────────────────────────
# PostgreSQL 16. En local : docker compose up -d postgres. En CI : Neon free tier.
DATABASE_URL=postgres://medanki:medanki@localhost:5432/medanki_dz

# Schéma PostgreSQL (utile pour isoler les tests d'intégration par run)
PG_SCHEMA=public

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# Clé privée RS256 pour signer les JWT (NE JAMAIS COMMITER). Doit faire 2048+ bits.
# En production, la générer avec : openssl genrsa -out jwt.pem 2048
JWT_SIGNING_KEY_PATH=./keys/jwt-private.pem

# Clé publique correspondante, embarquée dans le binaire mobile pour la
# vérification offline (Phase 7).
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem

# Durée de vie du token d'accès (15 min par défaut, §6.1 v2)
JWT_ACCESS_TTL_SECONDS=900

# Durée de vie du refresh token (30 j)
JWT_REFRESH_TTL_SECONDS=2592000

# Durée de vie du token d'entitlement (24 h, vérif offline)
JWT_ENTITLEMENT_TTL_SECONDS=86400

# Grace period après expiration (14 j, §8.1 v2)
ENTITLEMENT_GRACE_PERIOD_SECONDS=1209600

# ── Rate limiting ───────────────────────────────────────────────────────────
# 5 tentatives OTP par IP par 15 min, 100 events max par push
RATE_LIMIT_OTP_PER_15MIN=5
RATE_LIMIT_SYNC_BATCH=100

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development

# ── Ports ───────────────────────────────────────────────────────────────────
PORT=3000

# ── IA (Phase 18) ───────────────────────────────────────────────────────────
# Provider LLM : 'mock' (défaut, zéro coût, déterministe) | 'http' (API
# OpenAI-compatible : Mistral, OpenAI, ou modèle auto-hébergé vLLM/Ollama).
AI_LLM_PROVIDER=mock

# Config du provider HTTP (obligatoire seulement si AI_LLM_PROVIDER=http).
# JAMAIS de clé dans le repo : injection via secret manager (Phase 12 bis).
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=mistral-small-latest

# Quotas journaliers par utilisateur (comptés sur ai_generation_jobs, jour UTC)
AI_GENERATE_DAILY_QUOTA=20
AI_VOICE_DAILY_QUOTA=50
AI_TUTOR_DAILY_QUOTA=30
